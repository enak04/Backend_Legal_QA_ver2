# LLM Configuration
PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
FAST_MODEL=gpt-4o-mini
SMART_MODEL=gpt-4o

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DB_NAME=legal_intake_bot

# External Legal Service Configuration
USE_MOCK_SERVICE=true
SERVICE_URL=http://localhost:8001/legal-answer
SERVICE_API_KEY=mock_service_key

# Intake Flow Configuration
MAX_QUESTIONS_PER_TURN=2
HISTORY_WINDOW=10
MAX_COLLECTING_TURNS=14
SESSION_TTL_DAYS=30

# Debug and Logging
DEBUG=false

# Web Application Configuration
APP_API_KEY=test_app_key
ALLOWED_ORIGINS=*
